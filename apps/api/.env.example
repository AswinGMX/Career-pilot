API_PORT=4000
API_HOST=127.0.0.1
DATABASE_URL=postgresql://career_pilot:career_pilot@localhost:5432/career_pilot
REDIS_URL=redis://localhost:6379
ACCESS_TOKEN_SECRET=replace-me

REFRESH_TOKEN_SECRET=replace-me-too

# Primary LLM (Groq) — sign up at https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback LLM (Gemini) — sign up at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# App + OAuth — see docs/oauth-setup.md. Social sign-in stays disabled until set.
APP_BASE_URL=http://localhost:3000
OAUTH_REDIRECT_BASE_URL=http://localhost:4000/v1
# Google: https://console.cloud.google.com/apis/credentials (OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft: https://portal.azure.com → App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Pin a single Azure AD tenant instead of the multi-tenant "common" authority.
# Leave blank only if you intend to accept identities from any Microsoft tenant.
MICROSOFT_TENANT_ID=

# Express `trust proxy`. Decides whether x-forwarded-for may set request.ip,
# which the rate limiter and audit log key on. Unset/false = trust nothing.
# Behind one load balancer use 1; behind a known proxy range use a CIDR list.
TRUST_PROXY=

# Object storage. STORAGE_SIGNING_SECRET signs the local driver's URLs and must
# be >= 32 chars; production refuses to boot without it, and other environments
# fall back to a random per-process secret (signed URLs break on restart).
STORAGE_DRIVER=local
STORAGE_SIGNING_SECRET=
# Fail-fast bounds for the request-path Redis connection (rate limits, health).
REDIS_COMMAND_TIMEOUT_MS=1000
REDIS_CONNECT_TIMEOUT_MS=2000
